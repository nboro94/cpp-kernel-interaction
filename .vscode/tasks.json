{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build all files",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Iinclude", // Include the header files from the include directory
                "/Fe${workspaceFolder}\\kernel_interaction.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\kernel_interaction.cpp",
                "user32.lib", "gdi32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}